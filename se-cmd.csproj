<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SECmd</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>

    <!--
      Overwritten by the release workflow from the tag. A build from a working
      copy keeps this, so a file stamped 0.0.0 says plainly that it came from
      somebody's machine rather than from a release.
    -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Commands\ExportNif.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.51.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta7.25380.108" />

    <!--
      The conversion itself, and with it NIFSharp, LeanMeshIO and mopper.exe.
      What is left in this project is the command line over it, plus the Havok
      animation cache in AnimData/, which no converter needs.
    -->
    <PackageReference Include="NIFBX" Version="1.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      HKX2 as the package, not the submodule. The submodule points at upstream,
      whose reader rounds every float it reads to six decimal places and turns
      NaN into zero; the package is the fork that stopped doing that. Building
      the submodule here put its HKX2.dll in the output in place of the
      package's, so `exportcreature` and every other command that reaches Havok
      through HKFBX read a skeleton whose reference poses had been quantised:
      a cow's root bone came back as 0.136101 where the file says 0.13610077,
      and the skeleton.hkx written from it could no longer be byte-exact.
    -->
    <PackageReference Include="HKX2" Version="1.0.0" />

    <!--
      A creature's two skeleton files as one FBX, and back. The conversion is
      SKAssets', and importcreature and exportcreature are the command line over
      it; see the commands' remarks for why the split falls there.
    -->
    <PackageReference Include="SKAssets.Export" Version="0.1.8" />
  </ItemGroup>

</Project>
