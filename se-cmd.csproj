<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SECmd</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="External\HKX2Library\**" />
    <EmbeddedResource Remove="External\HKX2Library\**" />
    <None Remove="External\HKX2Library\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Commands\ExportNif.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests reach wire-format helpers that are not public API. -->
    <InternalsVisibleTo Include="se-cmd.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.51.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta7.25380.108" />

    <!--
      The raw FBX node tree: reading and writing a file as a recursive list of
      named records. Everything above it — skin deformers, bind poses, animation
      curves, custom properties — is ours, in Fbx/.

      This was MeshIO's raw layer, compiled in file by file from a submodule to
      reach a writer MeshIO keeps internal. LeanMeshIO is that layer extracted,
      with both directions public and the FileId and record-terminator bugs that
      made the SDK reject our output fixed.
    -->
    <PackageReference Include="LeanMeshIO" Version="1.0.2" />

    <!--
      Reading and writing the NIF itself: nif.xml, the item tree, both stream
      directions. What a file *means* — what a BSXFlags should say, how a
      constraint maps onto an FBX property — stays here, in Nif/ and Conversion/.
    -->
    <PackageReference Include="NIFSharp" Version="1.0.1" />

    <!--
      Puts mopper.exe beside the built assembly, where MopperProcessGenerator
      already looks for it. It is the fork's build, so -ccmm is present and a
      collision mesh with more than one material can be built without the user
      finding a mopper of their own.
    -->
    <PackageReference Include="Mopper.Native" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="External\HKX2Library\HKX2\HKX2.csproj" />
  </ItemGroup>

</Project>
